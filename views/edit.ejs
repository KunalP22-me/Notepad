<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Task</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <div class="main w-full min-h-screen bg-zinc-900 p-10 text-white">
        <a class="inline-block text-blue-500 mb-10" href="/">Go Back</a>
        <div class="max-w-xl">
            <h1 class="text-2xl font-semibold mb-6">Edit Task</h1>
            <form action="/edit" method="post">
                <input type="hidden" name="previous" value="<%= filename %>">

                <label class="block text-sm text-zinc-400 mb-1">Title (Filename):</label>
                <input class="block px-3 py-2 w-full rounded-lg bg-zinc-800 text-white outline-none mb-4" type="text" placeholder="Title" name="newTitle" value="<%= filename %>" required>

                <label class="block text-sm text-zinc-400 mb-1">Description:</label>
                <textarea class="block px-3 py-2 w-full rounded-lg bg-zinc-800 text-white outline-none mb-4 resize-none h-40" placeholder="Description" name="details"><%= filedata %></textarea>

                <input class="px-4 py-2 rounded-lg bg-yellow-600 hover:bg-yellow-700 text-white cursor-pointer font-medium" type="submit" value="Update Task">
            </form>
        </div>
    </div>
</body>

</html>