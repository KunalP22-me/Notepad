<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- tailwind css cdn to use it in ejs files -->
</head>

<body>
    <div class="main w-full min-h-screen bg-zinc-900">
        <div class="form p-10 text-white">
            <form action="/create" method="post" >
                <input class="block px-3 py-2 w-full rounded-lg bg-zinc-800 mb-3 outline-none" type="text" placeholder="Title" name="title" required>
                <textarea class="block px-3 py-2 w-full rounded-lg bg-zinc-800 mb-3 outline-none resize-none h-28" placeholder="description" name="details"></textarea>
                <input class="px-3 py-2 rounded-lg bg-blue-600 text-white cursor-pointer hover:bg-blue-700" type="submit" value="Create Task">
            </form>
        </div>
        <div class="tasks p-10 flex-wrap flex gap-4">
            <% if(files.length>0){%>
                <% files.forEach(function(val){%>
                    <div class="task w-72 px-3 py-4 rounded-md bg-zinc-800">
                        <h1 class="text-white text-xl tracking-tighter" ><%=val%></h1>
                        <div class="flex justify-between items-center w-full mt-1">
                            <a class="text-blue-500 inline-block" href="/file/<%=val%>">Read</a>
                            <a class="text-yellow-500 inline-block" href="/edit/<%=val%>">Edit</a>
                            <a class="text-red-500 inline-block" href="/delete/<%=val%>">Delete</a>
                        </div>
                    </div>
                    <%})%>
                        <% } else { %>
                            <h3 class="text-white text-xl tracking-tighter">No tasks found</h3>
                            <%}%>
        </div>
        <script src="/javascripts/script.js"></script>
        <!-- public folder is static means we can direct use it in src without adding public in src -->
</body>

</html>